{
    "manifests": {
        "phil/identity-provider-bundle": {
            "manifest": {
                "bundles": {
                    "Phil\\IdentityProviderBundle\\PhilIdentityProviderBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                }
            },
            "files": {
                "config/packages/phil_identity_provider.yaml": {
                    "contents": [
                        "# Accounts and the ways to sign in, one module per method, and the OpenID Connect provider. The firewall of",
                        "# config/packages/security.yaml names the bundle's user provider, user checker and authenticators: see the installation",
                        "# guide of phil/identity-provider-bundle, and its configuration guide for every option.",
                        "phil_identity_provider:",
                        "    site_name: Example",
                        "    login_route: app_login",
                        "    mailer:",
                        "        from: ~",
                        "    modules:",
                        "        passkeys: false",
                        "        totp: false",
                        "        recovery_codes: false",
                        "        login_link: false",
                        "        sms: false",
                        "        external: false",
                        "        oidc: false",
                        "    # passkeys: { rp_id: example.com, origins: ['https://example.com'] }",
                        "    # oidc: { issuer: 'https://id.example.com', algorithm: ES256 }",
                        "    # The modules totp and oidc keep secrets: encrypt them with symfony/key-management.",
                        "    # secrets: { kms_key: identity }",
                        "",
                        "when@test:",
                        "    phil_identity_provider:",
                        "        store: memory",
                        "        secrets: { allow_plaintext_secrets: true }",
                        ""
                    ],
                    "executable": false
                },
                "config/routes/phil_identity_provider.yaml": {
                    "contents": [
                        "# The routes of the modules turned on, and the OpenID Connect discovery document at",
                        "# /.well-known/openid-configuration when the provider is on.",
                        "phil_identity_provider:",
                        "    resource: .",
                        "    type: phil_identity_provider",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "c74e214e00245caa76d1b47f429262e0677e4477"
        }
    }
}
