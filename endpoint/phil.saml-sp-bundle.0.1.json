{
    "manifests": {
        "phil/saml-sp-bundle": {
            "manifest": {
                "bundles": {
                    "Phil\\SamlSpBundle\\PhilSamlSpBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                },
                "env": {
                    "SAML_SP_CERTIFICATE": "%kernel.project_dir%/config/saml/sp.crt",
                    "SAML_SP_PRIVATE_KEY": "%kernel.project_dir%/config/saml/sp.key"
                }
            },
            "files": {
                "config/packages/phil_saml_sp.yaml": {
                    "contents": [
                        "# Single sign-on through the SAML 2.0 identity provider of each organisation. See the installation and configuration",
                        "# guides of phil/saml-sp-bundle: the key pair of the service provider is made with the command they give, and kept out",
                        "# of the repository.",
                        "phil_saml_sp:",
                        "    signing:",
                        "        certificate: '%env(file:resolve:SAML_SP_CERTIFICATE)%'",
                        "        private_key: '%env(file:resolve:SAML_SP_PRIVATE_KEY)%'",
                        "    # The accepted assertions go to a table of the Doctrine DBAL connection when there is one \u2014 create it with a",
                        "    # migration, as the installation guide shows \u2014, to the cache pool otherwise: in prod, a pool shared by every server,",
                        "    # or single_server on a single server.",
                        "    # single_server: true",
                        "    identity_providers: {}",
                        "        # acme:",
                        "        #     metadata_url: 'https://login.microsoftonline.com/<tenant>/federationmetadata/2007-06/federationmetadata.xml?appid=<application>'",
                        "        #     preset: entra_id",
                        "",
                        "when@dev:",
                        "    phil_saml_sp:",
                        "        allow_localhost: true",
                        "        secure_cookie: false",
                        "        bind_to_browser: false",
                        ""
                    ],
                    "executable": false
                },
                "config/routes/phil_saml_sp.yaml": {
                    "contents": [
                        "phil_saml_sp:",
                        "    resource: '@PhilSamlSpBundle/config/routes.php'",
                        "    prefix: /saml",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "b7b84487cea08b67048279773a91de5b52163ec5"
        }
    }
}
