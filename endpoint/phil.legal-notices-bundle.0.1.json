{
    "manifests": {
        "phil/legal-notices-bundle": {
            "manifest": {
                "bundles": {
                    "Phil\\LegalNoticesBundle\\PhilLegalNoticesBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/",
                    "legal/": "legal/"
                }
            },
            "files": {
                "config/packages/phil_legal_notices.yaml": {
                    "contents": [
                        "# The legal notice and the privacy policy of the site: see vendor/phil/legal-notices-bundle/doc/configuration.md for",
                        "# every option. Both documents start as drafts, which no page shows: fill in the identity, adapt the bodies in legal/,",
                        "# then publish each version by giving it a publication date and removing its \"state: draft\".",
                        "phil_legal_notices:",
                        "    default_locale: en",
                        "    identity:",
                        "        # The fields a published document requires: the legal notice names the publisher, the director of",
                        "        # publication, a contact and the host; the privacy policy, the publisher, a contact and who answers for",
                        "        # personal information. Each is a placeholder of the bodies too: ${publisher_name}.",
                        "        site_name: ~",
                        "        publisher_name: ~",
                        "        publisher_address: ~",
                        "        publication_director: ~",
                        "        contact_email: ~",
                        "        host_name: ~",
                        "        host_address: ~",
                        "        host_contact: ~",
                        "        dpo_name: ~",
                        "        dpo_contact: ~",
                        "    documents:",
                        "        legal_notice:",
                        "            - number: 1",
                        "              format: markdown",
                        "              state: draft",
                        "              effective_at: '2026-12-01'",
                        "              # published_at: '2026-12-01'",
                        "              files:",
                        "                  en: '%kernel.project_dir%/legal/notice.en.md'",
                        "                  fr: '%kernel.project_dir%/legal/notice.fr.md'",
                        "        privacy_policy:",
                        "            - number: 1",
                        "              format: markdown",
                        "              state: draft",
                        "              effective_at: '2026-12-01'",
                        "              # published_at: '2026-12-01'",
                        "              files:",
                        "                  en: '%kernel.project_dir%/legal/privacy.en.md'",
                        "                  fr: '%kernel.project_dir%/legal/privacy.fr.md'",
                        "    consent:",
                        "        categories:",
                        "            necessary:",
                        "                necessary: true",
                        "                labels: { en: Necessary, fr: N\u00e9cessaires }",
                        "                descriptions: { en: The session of your visit., fr: La session de votre visite. }",
                        "                cookies: [PHPSESSID]",
                        ""
                    ],
                    "executable": false
                },
                "config/routes/phil_legal_notices.yaml": {
                    "contents": [
                        "# The pages of the legal notice and the privacy policy: /legal and /privacy, their history and each version, in",
                        "# English at the root and in French under /fr.",
                        "phil_legal_notices:",
                        "    resource: '@PhilLegalNoticesBundle/config/routes.php'",
                        "    prefix: { en: '', fr: '/fr' }",
                        ""
                    ],
                    "executable": false
                },
                "legal/notice.en.md": {
                    "contents": [
                        "# Legal notice",
                        "",
                        "This site is published by **${publisher_name}**, ${publisher_address}.",
                        "",
                        "Director of publication: ${publication_director}. Contact: ${contact_email}.",
                        "",
                        "It is hosted by ${host_name}, ${host_address} (${host_contact}).",
                        ""
                    ],
                    "executable": false
                },
                "legal/notice.fr.md": {
                    "contents": [
                        "# Mentions l\u00e9gales",
                        "",
                        "Ce site est publi\u00e9 par **${publisher_name}**, ${publisher_address}.",
                        "",
                        "Directeur ou directrice de la publication : ${publication_director}. Contact : ${contact_email}.",
                        "",
                        "Il est h\u00e9berg\u00e9 par ${host_name}, ${host_address} (${host_contact}).",
                        ""
                    ],
                    "executable": false
                },
                "legal/privacy.en.md": {
                    "contents": [
                        "# Privacy policy",
                        "",
                        "${publisher_name} is responsible for the personal information this site collects. Write to ${dpo_name},",
                        "${dpo_contact}, to see, correct or delete yours; any other question goes to ${contact_email}.",
                        "",
                        "The cookies of the site and how long it keeps your information are listed below.",
                        ""
                    ],
                    "executable": false
                },
                "legal/privacy.fr.md": {
                    "contents": [
                        "# Politique de confidentialit\u00e9",
                        "",
                        "${publisher_name} est responsable des renseignements personnels que ce site recueille. \u00c9crivez \u00e0 ${dpo_name},",
                        "${dpo_contact}, pour consulter, corriger ou supprimer les v\u00f4tres ; toute autre question va \u00e0 ${contact_email}.",
                        "",
                        "Les t\u00e9moins du site et la dur\u00e9e de conservation de vos renseignements sont pr\u00e9sent\u00e9s plus bas.",
                        ""
                    ],
                    "executable": false
                },
                "post-install.txt": {
                    "contents": [
                        "  * Install the recipes of the kit the pages draw:",
                        "    <comment>php bin/console ux:install badge --kit=github.com/parler-haut-interagir-librement/ux-kit</>",
                        "    <comment>php bin/console ux:install table --kit=github.com/parler-haut-interagir-librement/ux-kit</>",
                        "  * Fill in <comment>identity</> in <comment>config/packages/phil_legal_notices.yaml</>, adapt the bodies in <comment>legal/</>,",
                        "    publish each version, then run <comment>php bin/console phil:legal-notices:check</>.",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "ba9bd76a1cefb5fa499a777a66d35cd8cd69616c"
        }
    }
}
