{
    "manifests": {
        "phil/user-secrets-bundle": {
            "manifest": {
                "bundles": {
                    "Symfony\\Component\\KeyManagement\\KeyManagementBundle": [
                        "all"
                    ],
                    "Phil\\UserSecretsBundle\\PhilUserSecretsBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                },
                "env": {
                    "#1": "Fill with the output of bin/console phil:user-secrets:generate-key, in .env.local or the secrets vault",
                    "USER_SECRETS_KEY_2026": ""
                }
            },
            "files": {
                "config/packages/key_management.yaml": {
                    "contents": [
                        "# The local KMS that seals the secrets people entrust to the application. Generate its master key with",
                        "# bin/console phil:user-secrets:generate-key and keep it in .env.local or the secrets vault, never in the repository;",
                        "# losing it loses every secret it sealed. See the installation guide of phil/user-secrets-bundle to seal through the",
                        "# application's own KMS instead.",
                        "key_management:",
                        "    clients:",
                        "        local: 'sodium://?keys[k2026]=%env(USER_SECRETS_KEY_2026)%'",
                        ""
                    ],
                    "executable": false
                },
                "config/packages/phil_user_secrets.yaml": {
                    "contents": [
                        "# The master key that seals new secrets. See the configuration guide of phil/user-secrets-bundle.",
                        "phil_user_secrets:",
                        "    current_key: k2026",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "b3bd2ceaaf8c5c2d6854af818d8f5f7a71ad0557"
        }
    }
}
