{
    "manifests": {
        "phil/accessibility-statement-bundle": {
            "manifest": {
                "bundles": {
                    "Phil\\AccessibilityStatementBundle\\PhilAccessibilityStatementBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                }
            },
            "files": {
                "config/packages/phil_accessibility_statement.yaml": {
                    "contents": [
                        "# The accessibility statement of the site. Until a statement is written here, none is published: the page answers",
                        "# \"not found\" and the footer does not link to it. Write the first version with what the site really meets, as below;",
                        "# the installation guide of phil/accessibility-statement-bundle lists the other keys.",
                        "phil_accessibility_statement:",
                        "    # statement:",
                        "    #     version: 1",
                        "    #     published_at: '2026-01-01'",
                        "    #     entity: Example Org",
                        "    #     feedback: { email: accessibility@example.com, response_days: 10 }",
                        "    #     non_conformities:",
                        "    #         - { criterion: '1.4.3', description: { en: Grey text on the event pages. } }",
                        ""
                    ],
                    "executable": false
                },
                "config/routes/phil_accessibility_statement.yaml": {
                    "contents": [
                        "# The page of the statement, at /accessibility in English and /accessibilite in French. With",
                        "# phil_accessibility_statement.admin enabled, import '@PhilAccessibilityStatementBundle/config/admin_routes.php' under",
                        "# /admin, behind the firewall of the administration.",
                        "phil_accessibility_statement:",
                        "    resource: '@PhilAccessibilityStatementBundle/config/routes.php'",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "d1b76aa5f4edf43cf845fc6d05ed1604898b32bb"
        }
    }
}
