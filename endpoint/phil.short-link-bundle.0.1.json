{
    "manifests": {
        "phil/short-link-bundle": {
            "manifest": {
                "bundles": {
                    "Phil\\ShortLinkBundle\\PhilShortLinkBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                },
                "env": {
                    "SHORT_LINK_HOST": "go.example.com",
                    "SHORT_LINK_TARGET_HOST": "www.example.com"
                }
            },
            "files": {
                "config/packages/phil_short_link.yaml": {
                    "contents": [
                        "# Short links on a domain of their own, pointed at the application. Name the domain and the hosts a link may send to",
                        "# in .env.local; add a domain per locale when the site needs one. See the configuration guide of",
                        "# phil/short-link-bundle.",
                        "phil_short_link:",
                        "    domains:",
                        "        - { host: '%env(SHORT_LINK_HOST)%' }",
                        "    targets:",
                        "        allowed_hosts: ['%env(SHORT_LINK_TARGET_HOST)%']",
                        "    admin:",
                        "        role: ROLE_ADMIN",
                        ""
                    ],
                    "executable": false
                },
                "config/routes/phil_short_link.yaml": {
                    "contents": [
                        "# The administration of the short links, behind the application's firewall.",
                        "phil_short_link_admin:",
                        "    resource: '@PhilShortLinkBundle/config/routes/admin.php'",
                        "    prefix: /admin/short-links",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "292ecb98e2b8ccf59258b6a2a54a44a7e3b41000"
        }
    }
}
