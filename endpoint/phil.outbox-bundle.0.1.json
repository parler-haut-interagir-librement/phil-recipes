{
    "manifests": {
        "phil/outbox-bundle": {
            "manifest": {
                "bundles": {
                    "Phil\\OutboxBundle\\PhilOutboxBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                }
            },
            "files": {
                "config/packages/phil_outbox.yaml": {
                    "contents": [
                        "# The outbox shares the DBAL connection of the packages that record in it, so that a record joins their transaction.",
                        "# Create its table with a migration (doctrine:migrations:diff) or with phil:outbox:schema --force, then run",
                        "# phil:outbox:relay under a process manager, or enable the scheduler below. See the configuration guide of",
                        "# phil/outbox-bundle for the codecs, the Messenger bridge and the retention.",
                        "phil_outbox:",
                        "    connection: default",
                        "    relay:",
                        "        batch_size: 100",
                        "        lease: 60",
                        "    retention: 604800",
                        "    # scheduler:",
                        "    #     enabled: true",
                        "    #     frequency: 60",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "6a9da7cd75a60aed3ce0095a1910c84706c8740b"
        }
    }
}
