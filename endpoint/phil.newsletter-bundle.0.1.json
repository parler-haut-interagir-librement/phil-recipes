{
    "manifests": {
        "phil/newsletter-bundle": {
            "manifest": {
                "bundles": {
                    "Phil\\NewsletterBundle\\PhilNewsletterBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                },
                "env": {
                    "NEWSLETTER_SECRET": "change-me-to-a-random-secret-of-32-bytes-or-more"
                }
            },
            "files": {
                "config/packages/phil_newsletter.yaml": {
                    "contents": [
                        "# The newsletter of the site: its tables in the default Doctrine DBAL connection, which join the schema the ORM",
                        "# generates (run doctrine:migrations:diff), the key of the signed links of its messages, the site's base address and",
                        "# one sender profile. Route its messages to an asynchronous transport and consume the schedule `newsletter`. See the",
                        "# installation and configuration guides of phil/newsletter-bundle.",
                        "phil_newsletter:",
                        "    secret: '%env(NEWSLETTER_SECRET)%'",
                        "    sites:",
                        "        default: { base_url: 'https://example.com' }",
                        "    profiles:",
                        "        default: { from: 'news@example.com', from_name: 'Example' }",
                        "    # bounces:",
                        "    #     verp: { domain: 'example.com' }",
                        "    #     remote_event_consumer: mail_provider",
                        ""
                    ],
                    "executable": false
                },
                "config/routes/phil_newsletter.yaml": {
                    "contents": [
                        "# The subscription form, the confirmation, the unsubscription, the preference center, the tracked links and the",
                        "# preview of the Markdown editor, under /newsletter.",
                        "phil_newsletter:",
                        "    resource: '@PhilNewsletterBundle/config/routes.php'",
                        "    prefix: /newsletter",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "dd59664e38585317710b0d431169090ac547dffe"
        }
    }
}
