{
    "manifests": {
        "phil/calendar-bundle": {
            "manifest": {
                "bundles": {
                    "Phil\\CalendarBundle\\PhilCalendarBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                }
            },
            "files": {
                "config/packages/phil_calendar.yaml": {
                    "contents": [
                        "# The calendar of phil/calendar-bundle: see vendor/phil/calendar-bundle/doc/installation.md for every option.",
                        "phil_calendar:",
                        "    # A new event's time zone, an IANA identifier.",
                        "    default_timezone: UTC",
                        "    # The day weeks start on in the views, 1 Monday to 7 Sunday.",
                        "    first_weekday: 1",
                        ""
                    ],
                    "executable": false
                },
                "config/routes/phil_calendar.yaml": {
                    "contents": [
                        "# The pages and the iCalendar feeds of phil/calendar-bundle.",
                        "phil_calendar:",
                        "    resource: '@PhilCalendarBundle/config/routes.php'",
                        "    prefix: /calendar",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "3d9988cd864ff8838f21da8367fac97c02232634"
        }
    }
