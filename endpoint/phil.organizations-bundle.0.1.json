{
    "manifests": {
        "phil/organizations-bundle": {
            "manifest": {
                "bundles": {
                    "Phil\\OrganizationsBundle\\PhilOrganizationsBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                },
                "env": {
                    "#1": "The key of the invitation tokens, at least 32 bytes: set it with bin/console secrets:set ORGANIZATIONS_INVITATION_KEY",
                    "ORGANIZATIONS_INVITATION_KEY": ""
                }
            },
            "files": {
                "config/packages/phil_organizations.yaml": {
                    "contents": [
                        "# Organizations, their members and roles, teams and invitations. Members are named by the stable subject identifier of",
                        "# the user provider, never an e-mail address. See the configuration guide of phil/organizations-bundle.",
                        "phil_organizations:",
                        "    invitations:",
                        "        # At least 32 bytes, from the secrets vault: bin/console secrets:set ORGANIZATIONS_INVITATION_KEY",
                        "        hash_key: '%env(ORGANIZATIONS_INVITATION_KEY)%'",
                        "    # roles:",
                        "    #     billing: { permissions: [billing.read, billing.pay] }",
                        "    # team_roles:",
                        "    #     reviewer: { permissions: [review.approve] }",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "c8e23bacdf9a41d9ecfa8c2251ea2b8848efb243"
        }
    }
}
