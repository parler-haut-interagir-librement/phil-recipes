    "manifests": {
        "phil/data-table-bundle": {
            "manifest": {
                "bundles": {
                    "Phil\\DataTableBundle\\PhilDataTableBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                }
            },
            "files": {
                "config/packages/phil_data_table.yaml": {
