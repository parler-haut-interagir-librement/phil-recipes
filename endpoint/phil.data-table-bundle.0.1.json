                        "    cell_themes: []",
                        ""
                    ],
                    "executable": false
                },
                "config/routes/phil_data_table.yaml": {
                    "contents": [
                        "# The changes of a browser without JavaScript and the export of a table, behind the application's firewall.",
                        "phil_data_table:",
                        "    resource: '@PhilDataTableBundle/config/routes.php'",
                        "    prefix: /_tables",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "ccc45b6cccae8b2535bce5a58d8d294f6651c6ea"
        }
